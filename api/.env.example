# Copy to api/.env for local runs. On Cloud Run these are set as environment variables.
GCP_PROJECT=insurance-crisis
GCP_REGION=asia-south1
# Free AI Studio key (https://aistudio.google.com/apikey). Leave empty to use Vertex AI (needs billing).
GEMINI_API_KEY=
# dev: trust X-Dev-Uid header (local only). firebase: verify Firebase ID tokens.
AUTH_MODE=dev
# memory: lost on restart. firestore: persistent.
STORAGE_BACKEND=memory
# Cloud Storage bucket for photos; empty = local disk (api/.uploads).
STORAGE_BUCKET=
